# rejected: editor-intent-link.tsx (not accepted, do not ship)

"use client";

import { useRouter } from "next/navigation";
import {
  forwardRef,
  useCallback,
  type AnchorHTMLAttributes,
} from "react";

/**
 * A link to /editor that does NOT prefetch on viewport entry (saves ~244KB gz
 * on the homepage), but prefetches the editor bundle when the user shows clear
 * intent: pointer hover, keyboard focus, or pointerdown/touch start.
 * Falls back to a normal <Link>-compatible anchor; no feature change.
 */
export const EditorIntentLink = forwardRef<
  HTMLAnchorElement,
  AnchorHTMLAttributes<HTMLAnchorElement> & { href: string }
>(function EditorIntentLink({ href, onPointerDown, onMouseEnter, onFocus, ...rest }, ref) {
  const router = useRouter();
  const warm = useCallback(() => {
    try { router.prefetch(href); } catch { /* noop */ }
  }, [router, href]);
  return (
    <a
      ref={ref}
      href={href}
      {...rest}
      onPointerDown={(e) => { warm(); onPointerDown?.(e); }}
      onMouseEnter={(e) => { warm(); onMouseEnter?.(e); }}
      onFocus={(e) => { warm(); onFocus?.(e); }}
    />
  );
});
